---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import webIcono from "../images/icons/www icono blanco.png";
import linkedinIcono from "../images/icons/linkedin logo blanco.png";
import { UI, getLang } from "../i18n/ui";

interface Props {
	nombre: string;
	roles: string;
	fecha: string;
	subtitulo: string;
	logo?: ImageMetadata;
	logoSobreBlanco?: ImageMetadata;
	logros: string[];
	stack: string[];
	herramientas?: string[];
	web?: string;
	linkedin?: string;
	gracias: string;
	activo?: boolean;
}

const {
	nombre,
	roles,
	fecha,
	subtitulo,
	logo,
	logros,
	stack,
	herramientas = [],
	web,
	linkedin,
	gracias,
	activo = false,
} = Astro.props;
const t = UI[getLang(Astro.url)].exp;
const enlaces = [
	{ href: web, texto: "Web", icono: webIcono },
	{ href: linkedin, texto: "LinkedIn", icono: linkedinIcono },
].filter((e) => e.href);
const cajas = [
	{ titulo: t.stack, items: stack },
	{ titulo: t.herramientas, items: herramientas },
].filter((c) => c.items.length > 0);
---

<article class="item" hidden={!activo}>
	<div class="panel">
		<div class="presenta">
			<div>
				<p class="intro">{t.enRol(nombre)}</p>
				<h3 class="roles">{roles}</h3>
				<p class="fecha">{fecha}</p>
			</div>

			{
				logo ? (
					<div class="logo-caja">
						<Image
							class="logo"
							src={logo}
							alt={t.logoDe(nombre)}
							widths={[320, 640]}
							sizes="(min-width: 60rem) 24vw, 70vw"
						/>
					</div>
				) : (
					<p class="logo-texto">{nombre}</p>
				)
			}

			<div>
				<p class="subtitulo">{subtitulo}</p>
				{
					enlaces.length > 0 && (
						<div class="enlaces">
							{enlaces.map((e) => (
								<a
									class="vidrio pildora"
									href={e.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									<img
										src={e.icono.src}
										alt=""
										width="22"
										height="22"
									/>
									{e.texto}
								</a>
							))}
						</div>
					)
				}
			</div>
		</div>

		<ul class="logros">
			{logros.map((l) => <li>{l}</li>)}
		</ul>

		<div class="tecnologias">
			{
				cajas.map((c) => (
					<section class="caja">
						<h4>{c.titulo}</h4>
						<ul>
							{c.items.map((i) => (
								<li class="vidrio etiqueta">{i}</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</div>

	<p class="gracias">{gracias}</p>
</article>

<style>
	.item {
		position: relative;
		display: grid;
		grid-area: 1 / 1;
		min-width: 0;
	}
	/* Oculto pero ocupando su sitio, para que la altura del conjunto sea constante */
	.item[hidden] {
		display: grid;
		visibility: hidden;
		pointer-events: none;
	}

	/* Transición de contenido: la tarjeta no se anima, solo lo que lleva dentro */
	.item.entra .panel > *,
	.item.entra .gracias {
		animation: entra 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
		animation-delay: calc(var(--k, 0) * 70ms);
	}
	.item.entra .panel > :nth-child(2) {
		--k: 1;
	}
	.item.entra .panel > :nth-child(3) {
		--k: 2;
	}
	.item.entra .gracias {
		--k: 3;
	}
	.item.sale .panel > *,
	.item.sale .gracias {
		animation: sale 0.16s ease-in forwards;
	}
	@keyframes entra {
		from {
			opacity: 0;
			filter: blur(6px);
			translate: 0 12px;
		}
	}
	@keyframes sale {
		to {
			opacity: 0;
			translate: 0 -4px;
		}
	}

	.panel {
		display: grid;
		grid-template-columns: 34cqw 1fr 17cqw; /* la columna de tags crece hacia la izquierda */
		gap: 0.9cqw;
		min-height: 35cqw;
		padding: 2.9cqw 2.6cqw 2.9cqw 3.5cqw;
		border-radius: 1.6cqw;
		/* negro → blanco, todo al 10 % de opacidad */
		background: linear-gradient(90deg, rgb(0 0 0), rgb(255 255 255 / 0.1));
	}

	/* Columna izquierda */
	.presenta {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.5cqw;
		min-width: 0;
	}
	.intro {
		font-size: var(--fs-intro);
	}
	.roles {
		font-size: var(--fs-rol);
		font-weight: 700;
		line-height: 1.1;
		color: #c9304a;
		text-wrap: balance;
	}
	.fecha {
		margin-top: 0.4cqw;
		font-size: max(0.78rem, 1.08cqw);
		color: rgb(255 255 255 / 0.55);
	}
	.logo-caja {
		align-self: center;
		display: grid;
		grid-template: minmax(0, 1fr) / minmax(0, 1fr);
		place-items: center;
		width: 31cqw;
		max-width: 100%;
		height: 19cqw;
		padding: 0.5cqw;
		border-radius: 1.6cqw;
	}
	.presenta :global(.logo) {
		height: 100%;
		width: auto;
		max-width: 100%;
		object-fit: contain;
	}
	.logo-texto {
		align-self: center;
		font-size: var(--fs-nombre);
		font-weight: 700;
		text-align: center;
	}
	.subtitulo {
		transform: translateY(-2cqw);
		font-size: var(--fs-sub);
		line-height: 1.2;
		text-align: center;
	}
	.enlaces {
		transform: translateY(-1cqw);
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 2.5cqw;
		margin-top: 1cqw;
	}
	.pildora {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.2rem 0.9rem 0.2rem 0.7rem;
		border-radius: 999px;
		font-size: var(--fs-chip-grande);
		transition: transform 0.2s;
	}
	.pildora:hover {
		transform: translateY(-2px);
	}
	.pildora img {
		width: 1.35em;
		height: 1.35em;
		object-fit: contain;
	}

	/* Columna central */
	.logros {
		display: flex;
		flex-direction: column;
		gap: 1.5cqw;
	}
	.logros li {
		flex: 1;
		display: flex;
		align-items: center;
		padding: 1.3cqw;
		border: 1px solid rgb(255 255 255 / 0.22);
		font-size: var(--fs-cuerpo);
		line-height: 1.55;
	}
	/* Unidos se leen como un solo bloque: redondeo arriba en el primero y abajo en el último */
	.logros li:first-child {
		border-radius: 1.6cqw 1.6cqw 0 0;
	}
	.logros li:last-child {
		border-radius: 0 0 1.6cqw 1.6cqw;
	}
	.logros li:only-child {
		border-radius: 1.6cqw;
	}

	/* Columna derecha */
	.tecnologias {
		display: flex;
		flex-direction: column;
		gap: 1.7cqw;	}
	.caja {
		flex: 1 1 auto;
		display: flex;
		flex-direction: column;
		padding: 1.3cqw 1.2cqw;
		border: 1px solid rgb(255 255 255 / 0.22);
		border-radius: 1.4cqw;
	}
	.caja h4 {
		font-size: max(0.95rem, 1.45cqw);
		font-weight: 700;
		line-height: 1.15;
		margin-bottom: 1cqw;
	}
	.caja ul {
		flex: 1;
		display: flex;
		flex-flow: row wrap;
		align-content: flex-start;
		align-items: flex-start;
		gap: 0.9cqw 0.8cqw;
	}
	.etiqueta {
		padding: 0.25cqw 1cqw;
		border-radius: 999px;
		font-size: max(0.85rem, 1.3cqw);
		line-height: 1.25;
		white-space: nowrap;
	}

	.gracias {
		position: absolute;
		top: 100%;
		inset-inline: 0;
		margin-top: 1cqw;
		text-align: center;
		font-size: var(--fs-gracias);
		color: #8c8c8c;
	}

	@container (max-width: 60rem) {
		.panel {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 1.5rem 1.25rem;
			border-radius: 1.25rem;
		}
		.presenta {
			gap: 1.25rem;
		}
		.logo-caja {
			width: min(70%, 16rem);
			height: 9rem;
			padding: 1rem;
			border-radius: 1rem;
		}
		.logros {
			gap: 0.75rem;
		}
		.logros li {
			padding: 0.9rem 1rem;
		}
		.enlaces {
			gap: 0.6rem;
			margin-top: 0.75rem;
		}
		.tecnologias {
			gap: 1rem;
		}
		.caja {
			flex: none;
			padding: 1rem 1.1rem;
			border-radius: 1rem;
		}
		.caja h4 {
			font-size: 1.05rem;
			margin-bottom: 0.7rem;
		}
		.caja ul {
			flex: none;
			gap: 0.5rem;
		}
		.etiqueta {
			padding: 0.2rem 0.8rem;
			font-size: 0.95rem;
		}
		.gracias {
			margin-top: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.item.entra .panel > *,
		.item.entra .gracias {
			animation: aparece 0.25s ease-out backwards;
			animation-delay: 0s;
		}
		@keyframes aparece {
			from {
				opacity: 0;
			}
		}
		.pildora {
			transition: none;
		}
	}
</style>
