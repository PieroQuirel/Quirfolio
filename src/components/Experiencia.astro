---
import { Image } from 'astro:assets';
import ExperienciaItem from './ExperienciaItem.astro';
import { UI, getLang } from '../i18n/ui';
import { getExperiencia, nombreLargo } from '../i18n/datos';

const lang = getLang(Astro.url);
const t = UI[lang].exp;
const EXPERIENCIA = getExperiencia(lang);
---

<section class="experiencia reveal-host" id="experiencia">
	<div class="reveal from-bottom">
		<div class="exp">
			<h2 class="titulo">{t.titulo}</h2>

			<nav class="navegacion" aria-label={t.navegar}>
				<button type="button" class="flecha" data-dir="-1">
					<svg viewBox="0 0 24 24" aria-hidden="true"
						><path d="M21 12H4m6-6-6 6 6 6"></path></svg
					>
					{t.presente}
				</button>
				<div class="puntos">
					{
						EXPERIENCIA.map((e, i) => (
							<button
								type="button"
								class="punto"
								data-i={i}
								aria-label={t.ver(e.nombre)}
								aria-current={i === 0 ? "true" : "false"}
							/>
						))
					}
				</div>
				<button type="button" class="flecha" data-dir="1">
					{t.pasado}
					<svg viewBox="0 0 24 24" aria-hidden="true"
						><path d="M3 12h17m-6-6 6 6-6 6"></path></svg
					>
				</button>
			</nav>

			<div class="carrusel">
				<div class="pista" style="--i:0">
					{
						EXPERIENCIA.map((e, i) => (
							<button
								type="button"
								class:list={['tarjeta', { larga: nombreLargo(e.nombre) }]}
								data-i={i}
								aria-current={i === 0 ? "true" : "false"}
							>
								<span class="t-fecha">{e.fecha}</span>
								<span class="t-nombre">{e.nombre}</span>
								<span class="t-sub">{e.subtitulo}</span>
								{e.logo && (
									<span class="t-caja vidrio">
										{[e.logo, e.logoSobreBlanco].map(
											(logo, k) =>
												logo && (
													<Image class:list={['t-logo', { 't-alt': k === 1 }]} src={logo} alt="" widths={[160, 320]} sizes="8vw" />
												),
										)}
									</span>
								)}
							</button>
						))
					}
				</div>
			</div>

			<div class="detalle" aria-live="polite">
				{
					EXPERIENCIA.map((e, i) => (
						<ExperienciaItem {...e} activo={i === 0} />
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	import { arrastrable } from '../scripts/arrastre';

	const raiz = document.querySelector<HTMLElement>('.exp')!;
	const todos = <T extends HTMLElement>(s: string) => [...raiz.querySelectorAll<T>(s)];
	const tarjetas = todos('.tarjeta');
	const puntos = todos('.punto');
	const items = todos('.item');
	const flechas = todos<HTMLButtonElement>('.flecha');
	const selectores = [...tarjetas, ...puntos];
	const pista = raiz.querySelector<HTMLElement>('.pista')!;
	const carrusel = raiz.querySelector<HTMLElement>('.carrusel')!;
	const detalle = raiz.querySelector<HTMLElement>('.detalle')!;
	const reducido = matchMedia('(prefers-reduced-motion: reduce)');
	let actual = -1;
	let espera: number | undefined;

	// El contenido saliente se desvanece rápido y el entrante aparece escalonado; la tarjeta no se mueve
	const mostrar = (n: number) => {
		clearTimeout(espera);
		const saliente = items.find((el) => !el.hidden);
		const entrante = items[n];
		const cambiar = () => {
			items.forEach((el) => {
				el.hidden = el !== entrante;
				el.classList.remove('sale', 'entra');
			});
			if (saliente && saliente !== entrante) {
				void entrante.offsetWidth; // reinicia la animación aunque se repita
				entrante.classList.add('entra');
			}
		};
		if (saliente && saliente !== entrante && !reducido.matches) {
			saliente.classList.add('sale');
			espera = window.setTimeout(cambiar, 160);
		} else cambiar();
	};

	const ir = (n: number) => {
		n = Math.max(0, Math.min(items.length - 1, n));
		if (n === actual) return;
		actual = n;
		pista.style.setProperty('--i', String(actual));
		selectores.forEach((el) => el.setAttribute('aria-current', String(Number(el.dataset.i) === actual)));
		mostrar(actual);
		flechas.forEach((f) => {
			const destino = actual + Number(f.dataset.dir);
			f.disabled = destino < 0 || destino >= items.length;
		});
	};

	selectores.forEach((el) => el.addEventListener('click', () => ir(Number(el.dataset.i))));
	flechas.forEach((f) => f.addEventListener('click', () => ir(actual + Number(f.dataset.dir))));

	// Arrastre con mouse o tacto: la pista sigue al dedo y al soltar se acomoda en la tarjeta más cercana
	let dx = 0;
	const arrastre = arrastrable(carrusel, {
		alMover: (mov) => {
			const enBorde = (actual === 0 && mov > 0) || (actual === items.length - 1 && mov < 0);
			dx = enBorde ? mov * 0.35 : mov; // resistencia en los extremos
			pista.style.setProperty('--dx', `${dx}px`);
		},
		alSoltar: () => {
			const paso = tarjetas.length > 1 ? tarjetas[1].offsetLeft - tarjetas[0].offsetLeft : tarjetas[0].offsetWidth;
			let destino = actual + Math.round(-dx / paso);
			if (destino === actual && Math.abs(dx) > paso * 0.18) destino += dx < 0 ? 1 : -1; // un gesto corto también avanza
			pista.style.removeProperty('--dx');
			dx = 0;
			ir(destino);
		},
	});
	ir(0);

	// Rotación automática: cada 4 s, solo con la sección a la vista y sin cursor ni foco encima.
	// Cualquier interacción la cancela para siempre. Mientras rota, el detalle no se anuncia
	// a lectores de pantalla (aria-live="off"); al cancelarse vuelve a "polite".
	if (!reducido.matches) {
		let visible = false;
		let pausado = false;
		detalle.setAttribute('aria-live', 'off');
		const obs = new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.3 });
		obs.observe(raiz);
		const pausa = (si: boolean) => () => (pausado = si);
		raiz.addEventListener('pointerenter', pausa(true));
		raiz.addEventListener('pointerleave', pausa(false));
		raiz.addEventListener('focusin', pausa(true));
		raiz.addEventListener('focusout', pausa(false));
		const auto = window.setInterval(() => {
			if (visible && !pausado && !arrastre.presionado) ir((actual + 1) % items.length);
		}, 4000);
		const parar = () => {
			clearInterval(auto);
			obs.disconnect();
			detalle.setAttribute('aria-live', 'polite');
		};
		carrusel.addEventListener('pointerdown', parar, { once: true });
		[...selectores, ...flechas].forEach((el) => el.addEventListener('click', parar, { once: true }));
	}
</script>

<style>
	.experiencia {
		container-type: inline-size;
		width: min(100% - 2rem, 82rem);
		margin-inline: auto;
		padding-block: 6rem 9rem;
		scroll-margin-top: 4rem;
		color: #fff;
		font-family: "Saira Semi Condensed", sans-serif;
	}

	.exp {
		--w: 33cqw;
		--gap: 14.7cqw;
		--fs-titulo: 5.4cqw;
		--fs-nav: max(1.1rem, 2.6cqw);
		--fs-nombre: 3.75cqw;
		--fs-sub: max(0.95rem, 1.81cqw);
		--fs-fecha: max(0.85rem, 1.42cqw);
		--fs-intro: max(1rem, 1.62cqw);
		--fs-rol: max(1.35rem, 2.2cqw);
		--fs-cuerpo: max(0.95rem, 1.36cqw);
		--fs-caja: max(0.85rem, 1.03cqw);
		--fs-chip: max(0.75rem, 0.97cqw);
		--fs-chip-grande: max(0.95rem, 1.5cqw);
		--fs-gracias: max(0.95rem, 1.81cqw);

		display: grid;
		grid-template-columns: 5.4cqw 1fr;
		grid-template-areas:
			". nav"
			"titulo carrusel"
			"titulo detalle";
		column-gap: 0.8cqw;
		row-gap: 3.5cqw;
	}

	.titulo {
		grid-area: titulo;
		writing-mode: vertical-rl;
		rotate: 180deg;
		font-size: var(--fs-titulo);
		font-weight: 700;
		line-height: 1;
		text-align: center;
		white-space: nowrap;
	}

	.navegacion {
		grid-area: nav;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 3cqw;
		font-size: var(--fs-nav);
	}
	.flecha {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		cursor: pointer;
		transition:
			opacity 0.3s,
			transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.flecha svg {
		width: 1.15em;
		height: 1.15em;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.flecha:hover:not(:disabled) {
		transform: translateY(-2px);
	}
	.flecha:disabled {
		opacity: 0.3;
		cursor: default;
	}

	.puntos {
		display: flex;
		gap: 2.9cqw;
	}
	.punto {
		width: max(1.1rem, 2.6cqw);
		aspect-ratio: 1;
		border-radius: 50%;
		border: 2px dashed #fff;
		cursor: pointer;
		transition:
			background-color 0.3s,
			transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.punto:hover {
		transform: scale(1.15);
		background: rgb(255 255 255 / 0.2);
	}
	.punto[aria-current="true"] {
		background: #fff;
		border-color: #fff;
	}

	.carrusel {
		grid-area: carrusel;
		overflow: hidden;
		touch-action: pan-y; /* el scroll vertical sigue libre al arrastrar */
		padding-left: 3.5cqw;
		mask-image: linear-gradient(
			90deg,
			transparent 0,
			#000 3.5cqw,
			#000 90%,
			transparent 100%
		);
	}
	.pista {
		display: flex;
		gap: var(--gap);
		translate: calc(var(--i) * (var(--w) + var(--gap)) * -1 + var(--dx, 0px)) 0;
		transition: translate 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}
	/* Arrastrando: la pista sigue al puntero sin transición */
	.carrusel.arrastrando,
	.carrusel.arrastrando * {
		cursor: grabbing;
		user-select: none;
	}
	.carrusel.arrastrando .pista {
		transition: none;
	}
	.tarjeta {
		position: relative;
		flex: none;
		width: var(--w);
		min-height: 13.1cqw;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.2cqw;
		padding: 1.8cqw 1.9cqw;
		text-align: left;
		cursor: pointer;
		border: 0.2cqw dashed #fff;
		background: transparent;
		color: #fff;
		transition:
			background-color 0.35s,
			color 0.35s;
	}
	.tarjeta:hover {
		background: rgb(255 255 255 / 0.08);
	}
	.tarjeta[aria-current="true"] {
		background: #fff;
		color: #000;
		border-color: transparent;
		border-radius: 1.8cqw;
	}
	.t-fecha {
		font-size: var(--fs-fecha);
		color: rgb(255 255 255 / 0.65);
	}
	.t-nombre {
		font-size: var(--fs-nombre);
		font-weight: 700;
		line-height: 1.05;
		text-wrap: balance;
	}
	.larga .t-nombre {
		font-size: calc(var(--fs-nombre) * 0.64);
	}
	.t-sub {
		font-size: var(--fs-sub);
		line-height: 1.15;
	}
	.tarjeta[aria-current="true"] .t-fecha {
		color: #555;
	}
	/* Logo dentro de una tarjeta de cristal; sobre la tarjeta blanca el cristal se oscurece para que se lea */
	.t-caja {
		position: absolute;
		top: 1.2cqw;
		right: 1.5cqw;
		display: grid;
		grid-template: minmax(0, 1fr) / minmax(0, 1fr);
		place-items: center;
		width: 7.6cqw;
		height: 4cqw;
		padding: 0.6cqw;
		border-radius: 0.2cqw;
		transition:
			background 0.35s,
			border-color 0.35s;
	}
	.tarjeta[aria-current="true"] .t-caja {
		background: none;
		border-color: transparent;
		box-shadow: none;
		backdrop-filter: none;
	}
	/* Variante oscura del logo: solo sobre la tarjeta blanca */
	.tarjeta :global(.t-alt) {
		display: none;
	}
	.tarjeta[aria-current="true"] :global(.t-alt) {
		display: block;
	}
	.tarjeta[aria-current="true"] :global(.t-logo:has(+ .t-alt)) {
		display: none;
	}
	.tarjeta :global(.t-logo) {
		height: 100%;
		width: auto;
		max-width: 100%;
		object-fit: contain;
	}

	/* Línea que une las tarjetas */
	.tarjeta:not(:last-child)::after {
		content: "";
		position: absolute;
		left: 100%;
		top: 50%;
		width: var(--gap);
		height: 2px;
		background: linear-gradient(
			90deg,
			rgb(255 255 255 / 0.55),
			rgb(255 255 255 / 0.05)
		);
		transition: background 0.35s;
	}
	.tarjeta[aria-current="true"]:not(:last-child)::after {
		background: #fff;
	}

	/* Todas las experiencias comparten la misma celda: la altura es la de la más alta y no cambia al navegar */
	.detalle {
		grid-area: detalle;
		min-width: 0;
		display: grid;
	}

	/* Móvil y tablet */
	@container (max-width: 60rem) {
		.experiencia {
			padding-block: 6rem 7rem;
		}
		.exp {
			--w: 82cqw;
			--gap: 2.5rem;
			--fs-nombre: 2.4rem;
			grid-template-columns: 1fr;
			grid-template-areas: "titulo" "nav" "carrusel" "detalle";
			row-gap: 1.5rem;
		}
		.titulo {
			writing-mode: horizontal-tb;
			rotate: none;
			white-space: normal;
			font-size: 2.2rem;
			text-wrap: balance;
		}
		.navegacion {
			gap: 1rem;
		}
		.puntos {
			gap: 0.6rem;
		}
		.carrusel {
			padding-left: 0;
			mask-image: linear-gradient(90deg, #000 85%, transparent 100%);
		}
		.tarjeta {
			min-height: 9rem;
			padding: 1rem 1.25rem;
			border-width: 2px;
			border-radius: 0;
		}
		.tarjeta[aria-current="true"] {
			border-radius: 1.25rem;
		}
		.t-caja {
			top: 0.8rem;
			right: 1rem;
			width: 5rem;
			height: 3.4rem;
			padding: 0.4rem;
			border-radius: 0.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pista,
		.punto,
		.tarjeta,
		.flecha {
			transition: none;
		}
	}
</style>
