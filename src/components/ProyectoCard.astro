---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BotonesProyecto from './BotonesProyecto.astro';
import RuedaCarga from './RuedaCarga.astro';
import { UI, getLang } from '../i18n/ui';

interface Props {
	i: number; // posición en la lista (la usa el modal)
	titulo: string;
	fecha: string;
	rol?: string; // rol que tuve en el proyecto (va debajo del título)
	imagen?: ImageMetadata; // portada; si falta, la tarjeta muestra solo el texto
	color?: string; // color principal del degradado
	web?: string;
	github?: string;
}

const { i, titulo, fecha, rol, imagen, color = '#0077FF', web, github } = Astro.props;
const t = UI[getLang(Astro.url)].proy;
// Imagen más alta que ancha (o cuadrada): título en vertical al costado. Si es horizontal: título arriba.
const vertical = !!imagen && imagen.height >= imagen.width;
---

<article class:list={['tarjeta', vertical ? 'v' : 'h']} style={`--color:${color}`}>
	<div class="fondo" aria-hidden="true"></div>

	<div class="cabecera">
		<p class="fecha">{fecha}</p>
		<div class="nombre">
			<h3 class="titulo" style={`--n:${titulo.length}`}>{titulo}</h3>
			{rol && <p class="rol">{rol}</p>}
		</div>
		<div class="enlaces"><BotonesProyecto {web} {github} /></div>
	</div>

	{
		imagen && (
			<div class="zona" data-carga>
				<RuedaCarga tamano="max(2.4rem, 11cqw)" grosor="14%" />
				<Image
					class="imagen"
					src={imagen}
					alt=""
					widths={[400, 640, 900]}
					sizes="(min-width: 60rem) 25vw, 66vw"
					quality={62}
					loading="eager"
					fetchpriority="low"
					draggable="false"
				/>
			</div>
		)
	}

	<button type="button" class="abrir" data-i={i} aria-haspopup="dialog" aria-label={t.verDetalles(titulo)}></button>
</article>

<style>
	.tarjeta {
		--fs-fecha: max(0.8rem, 2.7cqw);
		position: relative;
		flex: none;
		container-type: inline-size;
		width: var(--w);
		aspect-ratio: 800 / 478;
		color: #fff;
		font-family: 'Saira Semi Condensed', sans-serif;
		will-change: transform; /* se transforma en 3D cada cuadro (ver Proyectos.astro) */
		backface-visibility: hidden;
	}

	/* Degradado lineal: color al 26 %, negro al 100 %, todo al 40 % de opacidad + sombra interior */
	.fondo {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}
	.fondo::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, var(--color) 26%, #000 100%);
		opacity: 0.4;
	}
	.fondo::after {
		content: '';
		position: absolute;
		inset: 0;
		box-shadow: inset 0 0.6cqw 1.4cqw rgb(0 0 0 / 0.5);
	}

	.fecha {
		font-size: var(--fs-fecha);
		color: rgb(255 255 255 / 0.62);
		white-space: nowrap;
	}
	.titulo {
		/* Más grande cuanto más corto: 14 letras o menos llegan a 8cqw, "Refugio de Patitas" ≈ 5.5cqw */
		font-size: max(1.35rem, min(8cqw, calc(100cqw / var(--n))));
		font-weight: 400;
		line-height: 1;
	}
	.rol {
		margin-top: 0.8cqw;
		font-size: var(--fs-fecha);
		line-height: 1.2;
		color: rgb(255 255 255 / 0.78);
		text-wrap: balance;
	}
	.enlaces {
		font-size: max(0.85rem, 2.9cqw);
	}

	.imagen {
		filter: drop-shadow(0 1.2cqw 1.6cqw rgb(0 0 0 / 0.6));
		user-select: none;
	}

	/* Cubre toda la tarjeta; los enlaces quedan por encima */
	.abrir {
		position: absolute;
		inset: 0;
		z-index: 1;
		cursor: pointer;
	}
	.abrir:focus-visible {
		outline: 2px solid #fff;
		outline-offset: -4px;
	}
	.cabecera {
		pointer-events: none;
	}
	.enlaces {
		position: relative;
		z-index: 2;
		pointer-events: auto;
	}

	/* ---------- Horizontal ---------- */
	.h {
		overflow: hidden;
	}
	/* El título ocupa la altura de la fecha + los botones y queda pegado a la esquina */
	.h .cabecera {
		position: absolute;
		top: 3.6cqw;
		left: 4cqw;
		right: 3.6cqw;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 1.4cqw 2cqw;
	}
	.h .nombre {
		grid-row: 1 / 3;
		align-self: center;
		min-width: 0;
	}
	.h .fecha {
		grid-column: 2;
		grid-row: 1;
		justify-self: end;
	}
	.h .enlaces {
		grid-column: 2;
		grid-row: 2;
		justify-self: end;
	}
	.h .zona {
		position: absolute;
		inset: 34% 0 5cqw;
		display: flex;
		justify-content: center;
		align-items: flex-end;
	}
	.h .imagen {
		max-width: 76%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
	}

	/* ---------- Vertical ---------- */
	.v .cabecera {
		display: contents;
	}
	.v .fecha {
		position: absolute;
		top: 4cqw;
		right: 3.8cqw;
	}
	/* Título y rol en vertical (se leen de abajo hacia arriba): el rol queda "debajo" del título, hacia el borde derecho */
	.v .nombre {
		position: absolute;
		right: 3.4cqw;
		bottom: 4.5cqw;
		max-height: 80%;
		writing-mode: vertical-rl;
		rotate: 180deg;
		pointer-events: none;
	}
	.v .titulo {
		font-size: max(1.6rem, 8.4cqw);
		white-space: nowrap;
	}
	.v .rol {
		margin-top: 0;
		margin-block-start: 1cqw;
		font-size: max(0.8rem, 2.9cqw);
	}
	.v .enlaces {
		position: absolute;
		top: 12cqw;
		right: 3.8cqw;
		width: 38%;
		display: flex;
		justify-content: flex-end;
	}
	.v .zona {
		position: absolute;
		left: 6cqw;
		bottom: 5%;
		height: 102%;
		display: flex;
		align-items: flex-end;
		pointer-events: none;
	}
	.v .imagen {
		height: 100%;
		width: auto;
		max-width: none;
		object-fit: contain;
		object-position: left bottom;
	}

	/* Móvil: más alta para que respire el contenido */
	@media (max-width: 40rem) {
		.h {
			aspect-ratio: 5 / 4;
		}
		.v {
			aspect-ratio: 5 / 3.4;
		}
	}

	/* Tarjeta angosta (móvil): más alta para que respire el contenido */
	@container (max-width: 30rem) {
		.h .zona {
			inset: 38% 0 5cqw;
		}
	}
</style>
