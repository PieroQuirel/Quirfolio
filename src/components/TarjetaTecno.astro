---
import '@fontsource/saira-semi-condensed/400.css';
import botones from '../images/Botones UI.png';
import webIcono from '../images/icons/www icono blanco.png';

interface Props {
	titulo: string; // texto de la cápsula, p. ej. "{ HTML }"
	etiqueta: string; // categoría, p. ej. "Frontend"
}

const { titulo, etiqueta } = Astro.props;
// Anchos (%) de las 6 barras decorativas, como en el diseño
const barras = [91, 100, 96, 11, 17, 66];
---

<div class="envoltura">
<article class="carta" aria-label={`${titulo} (${etiqueta})`} role="group">
	<img class="botones" src={botones.src} alt="" width="120" height="20" draggable="false" />

	<div class="panel">
		<h3 class="titulo" style={`--n:${titulo.length}`}>{titulo}</h3>

		<div class="barras" aria-hidden="true">
			{barras.map((w) => <span class="barra" style={`width:${w}%`} />)}
		</div>

		<div class="icono" aria-hidden="true"><slot /></div>

		<p class="vidrio etiqueta">
			<img src={webIcono.src} alt="" width="22" height="22" draggable="false" />
			{etiqueta}
		</p>
	</div>
</article>
</div>

<style>
	/* Contenedor de tamaño: las unidades cqw de la carta se miden contra él */
	.envoltura {
		container-type: inline-size;
		width: 100%;
	}
	.carta {
		width: 100%;
		aspect-ratio: 889 / 1253;
		display: flex;
		flex-direction: column;
		gap: 3cqw;
		padding: 2.6cqw 4.6cqw 4.6cqw;
		border-radius: 4.5cqw;
		background: #fff;
		color: #fff;
		font-family: 'Saira Semi Condensed', sans-serif;
		/* el texto no se puede seleccionar y el cursor se queda como está (flecha) */
		user-select: none;
		-webkit-user-select: none;
		cursor: default;
	}
	
	.botones {
		align-self: flex-end;
		width: 36cqw;
		height: auto;
		flex: none;
		user-select: none;
	}

	.panel {
		position: relative;
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		padding: 0 0.5cqw;
		overflow: hidden;
		border-radius: 3.6cqw 3.6cqw 3.6cqw 0;
		background: linear-gradient(180deg, #000000, #2a2a2a);
	}

	/* Relieve al inclinar (variables que define <Inclinar>): el brillo y el reflejo siguen la forma del panel negro */
	.panel::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 3;
		border-radius: inherit;
		pointer-events: none;
		opacity: var(--on, 0);
		transition: opacity 0.3s ease-out;
		background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgb(255 255 255 / var(--brillo, 0.12)) 0%, transparent 65%);
		box-shadow:
			inset 0 0 0 0.3cqw rgb(255 255 255 / 0.1),
			inset var(--ix, 0px) var(--iy, 0px) 4cqw rgb(0 0 0 / 0.5);
	}
	.panel::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 4;
		border-radius: inherit;
		padding: 0.6cqw;
		pointer-events: none;
		opacity: var(--on, 0);
		transition: opacity 0.3s ease-out;
		background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgb(255 255 255 / 0.8) 0%, rgb(255 255 255 / 0.15) 45%, transparent 75%);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
	}

	/* Cápsula: vidrio totalmente transparente, solo brillan los bordes */
	.titulo {
		position: relative;
		z-index: 2;
		flex: none;
		margin: 4cqw 4cqw 0;
		height: 21cqw;
		display: grid;
		place-items: center;
		padding-inline: 6cqw;
		border-radius: 999px;
		border: 0.4cqw solid rgb(255 255 255 / 0.28);
		border-top-color: rgb(255 255 255 / 0.55);
		background: transparent;
		box-shadow:
			inset 0 0.8cqw 1.2cqw rgb(255 255 255 / 0.22),
			inset 0 -0.6cqw 1cqw rgb(255 255 255 / 0.1);
		font-size: min(14cqw, calc(88cqw / var(--n) * 1.7));
		font-weight: 400;
		line-height: 1;
		white-space: nowrap;
		text-align: center;
	}

	/* Barras decorativas: borde al 20 %, relleno al 40 % */
	.barras {
		position: absolute;
		inset: 33cqw 4cqw auto;
		display: flex;
		flex-direction: column;
		gap: 4.4cqw;
	}
	.barra {
		height: 7.6cqw;
		border-radius: 1.6cqw;
		border: 1px solid rgb(255 255 255 / 0.2);
		background: rgb(110 110 110 / 0.4); /* gris al 40 %: sobre el negro se lee gris oscuro, como en el diseño */
		box-shadow: inset 0 0.4cqw 0.8cqw rgb(255 255 255 / 0.25);
	}

	/* Icono grande con sombra detrás para despegarlo del fondo */
	.icono {
		position: absolute;
		inset: 38cqw 8cqw 24cqw;
		display: grid;
		place-items: center;
		pointer-events: none;
	}
	.icono :global(svg) {
		width: 100%;
		height: 100%;
		filter: drop-shadow(0 2.4cqw 3.4cqw rgb(0 0 0 / 0.75));
	}

	/* Pegada a la esquina inferior izquierda del panel; solo redondeada arriba a la derecha */
	.etiqueta {
		position: absolute;
		left: 0;
		bottom: 0;
		display: inline-flex;
		align-items: center;
		gap: 2.2cqw;
		padding: 2.2cqw 6cqw 2.2cqw 4cqw;
		border-radius: 0 3cqw 0 0;
		border-width: 0.4cqw;
		border-left-width: 0;
		border-bottom-width: 0;
		background: linear-gradient(180deg, rgb(255 255 255 / 0.3), rgb(255 255 255 / 0.2));
		font-size: 11.5cqw;
		line-height: 1;
		box-shadow: inset 0 0.5cqw 0.5cqw rgb(255 255 255 / 0.25);
	}
	.etiqueta img {
		width: 1em;
		height: 1em;
		object-fit: contain;
	}
</style>
