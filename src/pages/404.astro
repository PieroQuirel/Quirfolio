---
/**
 * Página 404: una "ventana" del sistema (marco blanco, botones de ventana y panel negro,
 * como las cartas de Habilidades) con el error. Netlify la sirve sola para cualquier ruta inexistente.
 * Va en los dos idiomas a la vez porque la 404 no sabe de qué versión venía la persona.
 */
import Layout from '../layouts/Layout.astro';
import '../styles/tailwind.css';
import '@fontsource-variable/saira/wdth.css';
import '@fontsource/saira-semi-condensed/400.css';
import '@fontsource/saira-semi-condensed/700.css';
import botones from '../images/Botones UI.png';

const barras = [92, 100, 70, 14];
---

<Layout lang="es" base="/" noindex title="404 | Piero Quiroz" description="Esta página no existe. / This page does not exist.">
	<main class="error">
		<section class="ventana" aria-labelledby="t404">
			<img class="botones" src={botones.src} alt="" width="120" height="20" draggable="false" />

			<div class="panel">
				<div class="barras" aria-hidden="true">
					{barras.map((w) => <span style={`width:${w}%`} />)}
				</div>

				<p class="codigo" id="t404" aria-label="Error 404">
					<span aria-hidden="true">404</span>
				</p>

				<div class="mensaje">
					<h1>Esta página no existe</h1>
					<p>El enlace está roto o la página se movió.</p>
					<h2 lang="en">This page does not exist</h2>
					<p lang="en">The link is broken or the page has moved.</p>
				</div>

				<div class="acciones">
					<a class="vidrio pildora" href="/">Volver al inicio</a>
					<a class="vidrio pildora" href="/en/">Back to home (EN)</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.error {
		min-height: 100svh;
		display: grid;
		place-items: center;
		padding: 6rem 1rem 3rem;
	}
	.ventana {
		container-type: inline-size;
		width: min(100%, 44rem);
		padding: 1.6rem 1.6rem 1.6rem;
		border-radius: 1.6rem;
		background: #fff;
		box-shadow: 0 30px 70px rgb(0 0 0 / 0.6);
		animation: entra 0.7s cubic-bezier(0.16, 1, 0.3, 1) backwards;
	}
	.botones {
		display: block;
		width: min(30%, 8rem);
		height: auto;
		margin: 0 0 0.6rem auto;
	}
	.panel {
		position: relative;
		overflow: hidden;
		display: grid;
		justify-items: center;
		gap: 1.2rem;
		padding: 2.2rem 1.5rem 2rem;
		border-radius: 1.3rem;
		background: linear-gradient(180deg, #000, #2a2a2a);
		color: #fff;
		text-align: center;
	}

	/* Barras decorativas de relleno (las mismas de las cartas), detrás del número */
	.barras {
		position: absolute;
		inset: 1.5rem 1.5rem auto;
		display: grid;
		gap: 0.9rem;
		pointer-events: none;
		/* se desvanecen hacia abajo para no restar lectura al mensaje */
		-webkit-mask-image: linear-gradient(#000 55%, transparent);
		mask-image: linear-gradient(#000 55%, transparent);
	}
	.barras span {
		height: 2.2rem;
		border-radius: 0.5rem;
		border: 1px solid rgb(255 255 255 / 0.1);
		background: rgb(80 80 80 / 0.4);
		box-shadow: inset 0 1px 2px rgb(255 255 255 / 0.12);
	}

	.codigo {
		position: relative;
		font-family: 'Saira Variable', sans-serif;
		font-weight: 800;
		font-stretch: 87%;
		font-size: clamp(6rem, 30cqw, 12rem);
		line-height: 1;
		letter-spacing: -0.02em;
		text-shadow: 0 1rem 2rem rgb(0 0 0 / 0.7);
	}
	.mensaje {
		position: relative;
		display: grid;
		gap: 0.35rem;
		font-family: 'Saira Semi Condensed', sans-serif;
	}
	.mensaje h1 {
		font-size: clamp(1.6rem, 6cqw, 2.4rem);
		font-weight: 700;
		line-height: 1.1;
	}
	.mensaje h2 {
		margin-top: 0.8rem;
		font-size: clamp(1.1rem, 3.6cqw, 1.4rem);
		font-weight: 700;
		color: rgb(255 255 255 / 0.75);
	}
	.mensaje p {
		font-size: clamp(1rem, 3cqw, 1.15rem);
		color: rgb(255 255 255 / 0.7);
	}
	.acciones {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.7rem;
	}
	.pildora {
		position: relative;
		isolation: isolate; /* el relleno blanco queda detrás del texto pero dentro del botón */
		display: inline-flex;
		align-items: center;
		padding: 0.55rem 1.3rem;
		border-radius: 999px;
		font-family: 'Saira Semi Condensed', sans-serif;
		font-size: 1.1rem;
		color: #fff;
		transition: color 0.2s;
	}
	/* El relleno blanco es una capa que solo cambia de opacidad: animar 'background' del vidrio
	   (degradado → color sólido) no se interpola y, junto al blur, provocaba parpadeos al pasar rápido */
	.pildora::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		background: #fff;
		opacity: 0;
		transition: opacity 0.2s;
	}
	.pildora:hover {
		color: #000;
	}
	.pildora:hover::before {
		opacity: 1;
	}
	.pildora:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}
	@keyframes entra {
		from {
			opacity: 0;
			translate: 0 1.2rem;
			scale: 0.97;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ventana {
			animation: none;
		}
		.pildora,
		.pildora::before {
			transition: none;
		}
	}
</style>
